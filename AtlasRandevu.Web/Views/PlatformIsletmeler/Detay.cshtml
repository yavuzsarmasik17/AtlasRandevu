@model AtlasRandevu.Domain.Entities.Isletme
@using AtlasRandevu.Domain.Entities
@{
    Layout = "_PlatformLayout";
    ViewData["Title"] = "İşletme Detayı";
    var hizmetler = ViewBag.Hizmetler as List<Hizmet> ?? new List<Hizmet>();
    var subeler = Model.Subeler?.OrderBy(x => x.Ad).ToList() ?? new List<Sube>();
    var onayli = Model.Durum == "Onaylandi";
    var bekliyor = Model.Durum == "OnayBekliyor";
    var durumMetni = Model.Durum == "Pasif" ? "Pasif İşletme" : onayli ? "Onaylı İşletme" : bekliyor ? "Onay Bekliyor" : Model.Durum == "Reddedildi" ? "Reddedildi" : Model.Durum;
    var durumClass = Model.Durum == "Pasif" ? "inactive" : onayli ? "approved" : bekliyor ? "pending" : "rejected";
    var aktifHizmet = hizmetler.Count(x => x.AktifMi);
    var aktifSube = subeler.Count(x => x.Durum == "Aktif");
}
<style>
    .pd-wrap {
        max-width: 1450px;
        margin: 0 auto;
        color: #14213d;
    }

    .pd-topline {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .pd-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #63758e;
        text-decoration: none;
        font-weight: 650;
        font-size: 14px;
    }

        .pd-back:hover {
            color: #245bde;
        }

    .pd-eyebrow {
        color: #8a99af;
        font-size: 12px;
        font-weight: 750;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }

    .pd-panel {
        background: #fff;
        border: 1px solid #e7edf6;
        border-radius: 20px;
        box-shadow: 0 9px 30px rgba(24, 44, 80, .035);
    }

    .pd-hero {
        overflow: hidden;
        margin-bottom: 20px;
    }

    .pd-cover {
        height: 115px;
        background: linear-gradient(110deg, #13264c, #2456bc 65%, #5d86ed);
        position: relative;
    }

        .pd-cover::after {
            content: "";
            position: absolute;
            right: -25px;
            top: -95px;
            width: 260px;
            height: 260px;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 50%;
        }

    .pd-hero-body {
        padding: 0 28px 27px;
    }

    .pd-hero-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-top: -35px;
        position: relative;
    }

    .pd-identity {
        display: flex;
        align-items: flex-end;
        gap: 17px;
        min-width: 0;
    }

    .pd-logo {
        width: 88px;
        height: 88px;
        flex-shrink: 0;
        background: #fff;
        border: 5px solid #fff;
        border-radius: 20px;
        box-shadow: 0 6px 22px rgba(19,37,73,.15);
        display: grid;
        place-items: center;
        color: #2456bc;
        font-size: 34px;
        font-weight: 850;
        overflow: hidden;
    }

        .pd-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .pd-business-name {
        font-size: clamp(23px,2.5vw,32px);
        font-weight: 850;
        letter-spacing: -.7px;
        margin: 42px 0 3px;
        overflow-wrap: anywhere;
    }

    .pd-sector {
        color: #7d8da5;
        font-size: 14px;
        margin: 0;
    }

    .pd-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 100px;
        padding: 9px 13px;
        font-size: 12px;
        font-weight: 750;
        white-space: nowrap;
    }

        .pd-status.approved {
            background: #e8f8ef;
            color: #118457;
        }

        .pd-status.pending {
            background: #fff3dd;
            color: #a56a06;
        }

        .pd-status.rejected {
            background: #fff0f0;
            color: #bf4050;
        }

        .pd-status.inactive {
            background: #edf0f6;
            color: #5f6c83;
        }

    .pd-action-group {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

        .pd-action-group form {
            margin: 0;
        }

    .pd-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 10px;
        font-weight: 700;
        padding: 10px 15px;
        font-size: 13px;
        text-decoration: none;
        cursor: pointer;
        background: #fff;
    }

        .pd-action-btn.pause {
            color: #9a6700;
            border: 1px solid #e4b95b;
        }

        .pd-action-btn.resume {
            color: #148456;
            border: 1px solid #81cba5;
        }

        .pd-action-btn.delete {
            color: #c83748;
            border: 1px solid #e6a5ad;
        }

        .pd-action-btn:hover {
            filter: brightness(.96);
        }

    .pd-description {
        color: #667890;
        font-size: 14px;
        margin: 17px 0 0;
        line-height: 1.7;
    }

    .pd-stats {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .pd-stat {
        padding: 20px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .pd-stat-label {
        color: #8796ab;
        font-size: 12px;
        font-weight: 700;
    }

    .pd-stat-value {
        font-size: 27px;
        font-weight: 850;
        margin-top: 5px;
        letter-spacing: -.6px;
    }

    .pd-stat-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        font-size: 20px;
        background: #edf3ff;
        color: #245bdc;
    }

    .pd-grid {
        display: grid;
        grid-template-columns: minmax(0,1fr) minmax(0,1fr);
        gap: 20px;
    }

    .pd-section {
        padding: 24px;
        min-width: 0;
    }

    .pd-section-title {
        margin: 0 0 20px;
        font-size: 18px;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .pd-section-sub {
        color: #8998ad;
        font-size: 13px;
        margin-top: -12px;
        margin-bottom: 19px;
    }

    .pd-info-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 20px 24px;
    }

    .pd-info-label {
        color: #91a0b5;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: .7px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .pd-info-value {
        font-size: 14px;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

        .pd-info-value a {
            color: #245bdc;
            text-decoration: none;
        }

    .pd-wide {
        grid-column: 1/-1;
    }

    .pd-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 17px 0;
        border-top: 1px solid #edf1f7;
    }

        .pd-item:first-of-type {
            border-top: none;
            padding-top: 0;
        }

    .pd-item-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: #edf3ff;
        color: #245bdc;
        font-size: 19px;
    }

    .pd-item-content {
        min-width: 0;
        flex: 1;
    }

    .pd-item-name {
        font-size: 14px;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .pd-item-detail {
        font-size: 13px;
        color: #7b8ba2;
        margin-top: 5px;
        line-height: 1.55;
        overflow-wrap: anywhere;
    }

    .pd-mini-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 750;
        padding: 4px 8px;
        border-radius: 7px;
        background: #e9f8ef;
        color: #17885a;
        margin-left: 7px;
    }

        .pd-mini-badge.off {
            background: #f0f2f6;
            color: #7a8798;
        }

    .pd-price {
        white-space: nowrap;
        color: #14213d;
        font-size: 15px;
        font-weight: 850;
    }

    .pd-empty {
        padding: 25px 12px;
        color: #8796aa;
        text-align: center;
        font-size: 14px;
        background: #f8faff;
        border-radius: 12px;
    }

    @@media(max-width: 900px) {
        .pd-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width: 600px) {
        .pd-stats {
            grid-template-columns: 1fr;
        }

        .pd-hero-body {
            padding: 0 18px 22px;
        }

        .pd-identity {
            align-items: center;
        }

        .pd-business-name {
            margin-top: 40px;
        }

        .pd-section {
            padding: 20px;
        }

        .pd-info-grid {
            grid-template-columns: 1fr;
        }

        .pd-wide {
            grid-column: auto;
        }
    }
</style>
<div class="pd-wrap">
    <div class="pd-topline">
        <a asp-controller="PlatformIsletmeler" asp-action="Index" class="pd-back">← İşletmeler Listesine Dön</a>
        <div class="pd-action-group">
            <span class="pd-eyebrow">İşletme Yönetimi / Detay</span>

            @if (Model.Durum == "Onaylandi")
            {
                <form asp-controller="PlatformIsletmeler" asp-action="PasifeAl" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Bu işletme pasife alınsın mı?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pd-action-btn pause">⏸ İşletmeyi Pasife Al</button>
                </form>
            }
            else if (Model.Durum == "Pasif")
            {
                <form asp-controller="PlatformIsletmeler" asp-action="Aktiflestir" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Bu işletme yeniden aktifleştirilsin mi?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pd-action-btn resume">✓ Yeniden Aktifleştir</button>
                </form>
            }

            <a asp-controller="PlatformIsletmeler" asp-action="Sil" asp-route-id="@Model.Id"
               class="pd-action-btn delete">🗑 İşletmeyi Kalıcı Sil</a>
        </div>
    </div>

    @if (TempData["Basari"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Basari"]</div>
    }
    @if (TempData["Hata"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Hata"]</div>
    }

    <section class="pd-panel pd-section" style="margin-bottom:20px">
        <h2 class="pd-section-title">🔑 İşletme Sahibi Şifre Yönetimi</h2>
        <p class="pd-section-sub">İşletme sahibinin kayıtlı e-posta adresini girerek şifresini değiştirebilirsiniz. Eski şifre görüntülenmez.</p>
        <button type="button" class="pd-action-btn resume" data-bs-toggle="modal" data-bs-target="#sifreSifirlaModal">Şifre Sıfırla</button>
    </section>

    <div class="modal fade" id="sifreSifirlaModal" tabindex="-1" aria-labelledby="sifreSifirlaBaslik" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="PlatformSifre" asp-action="Sifirla" asp-route-id="@Model.Id" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="sifreSifirlaBaslik">İşletme Sahibi Şifre Sıfırla</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">Yalnızca bu işletmeye bağlı aktif işletme sahibinin şifresi değiştirilebilir.</p>
                        <div class="mb-3">
                            <label class="form-label" for="sifreEposta">İşletme sahibinin kayıtlı e-postası</label>
                            <input class="form-control" type="email" name="eposta" id="sifreEposta" maxlength="256" required autocomplete="off" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="yeniSifre">Yeni şifre</label>
                            <input class="form-control" type="password" name="yeniSifre" id="yeniSifre" minlength="8" required autocomplete="new-password" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="yeniSifreTekrar">Yeni şifre (tekrar)</label>
                            <input class="form-control" type="password" name="yeniSifreTekrar" id="yeniSifreTekrar" minlength="8" required autocomplete="new-password" />
                        </div>
                        <div class="alert alert-warning mb-0">İşlem onaylandığında eski şifre geçersiz olacaktır. Yeni şifreyi güvenli biçimde işletme sahibine iletin.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Bu işletme sahibinin şifresi değiştirilsin mi?');">Şifreyi Değiştir</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <section class="pd-panel pd-hero">
        <div class="pd-cover"></div>
        <div class="pd-hero-body">
            <div class="pd-hero-row">
                <div class="pd-identity">
                    <div class="pd-logo">
                        @if (!string.IsNullOrWhiteSpace(Model.LogoYolu))
                        {
                            <img src="@Url.Content(Model.LogoYolu)" alt="@Model.Ad logosu" />
                        }
                        else
                        {
                            <span>@(string.IsNullOrWhiteSpace(Model.Ad) ? "A" : Model.Ad.Substring(0, 1).ToUpper())</span>
                        }
                    </div>
                    <div>
                        <h1 class="pd-business-name">@Model.Ad</h1>
                        <p class="pd-sector">@(Model.Sektor?.Ad ?? "Sektör belirtilmedi") · İşletme #@Model.Id</p>
                    </div>
                </div>
                <span class="pd-status @durumClass">● @durumMetni</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Slogan))
            {
                <p class="pd-description">@Model.Slogan</p>
            }
        </div>
    </section>

    <div class="pd-stats">
        <div class="pd-panel pd-stat"><div><div class="pd-stat-label">Toplam Şube</div><div class="pd-stat-value">@subeler.Count</div><div class="pd-stat-label">@aktifSube aktif şube</div></div><div class="pd-stat-icon">⌖</div></div>
        <div class="pd-panel pd-stat"><div><div class="pd-stat-label">Toplam Hizmet</div><div class="pd-stat-value">@hizmetler.Count</div><div class="pd-stat-label">@aktifHizmet aktif hizmet</div></div><div class="pd-stat-icon">✂</div></div>
        <div class="pd-panel pd-stat"><div><div class="pd-stat-label">Başvuru Durumu</div><div class="pd-stat-value" style="font-size:19px;margin-top:10px">@durumMetni</div><div class="pd-stat-label">İşletme #@Model.Id</div></div><div class="pd-stat-icon">✓</div></div>
    </div>

    <div class="pd-grid">
        <section class="pd-panel pd-section">
            <h2 class="pd-section-title">▤ İşletme Bilgileri</h2>
            <p class="pd-section-sub">İşletmenin kayıt ve tanıtım bilgileri</p>
            <div class="pd-info-grid">
                <div><div class="pd-info-label">Ticari Unvan</div><div class="pd-info-value">@(string.IsNullOrWhiteSpace(Model.TicariUnvan) ? "—" : Model.TicariUnvan)</div></div>
                <div><div class="pd-info-label">Sektör</div><div class="pd-info-value">@(Model.Sektor?.Ad ?? "—")</div></div>
                <div><div class="pd-info-label">Başvuru Tarihi</div><div class="pd-info-value">@Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</div></div>
                <div><div class="pd-info-label">Onay Tarihi</div><div class="pd-info-value">@(Model.OnayTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "—")</div></div>
                <div class="pd-wide"><div class="pd-info-label">Web Sitesi</div><div class="pd-info-value">@(string.IsNullOrWhiteSpace(Model.WebSitesi) ? "—" : Model.WebSitesi)</div></div>
                <div class="pd-wide"><div class="pd-info-label">Hakkında</div><div class="pd-info-value" style="font-weight:500;line-height:1.7;white-space:pre-wrap">@(string.IsNullOrWhiteSpace(Model.Hakkimizda) ? "Henüz açıklama eklenmemiş." : Model.Hakkimizda)</div></div>
            </div>
        </section>

        <section class="pd-panel pd-section">
            <h2 class="pd-section-title">⌖ Şubeler (@subeler.Count)</h2>
            <p class="pd-section-sub">İşletmeye bağlı hizmet noktaları</p>
            @if (!subeler.Any())
            {
                <div class="pd-empty">Bu işletmeye ait şube bulunmuyor.</div>
            }
            @foreach (var sube in subeler)
            {
                <div class="pd-item">
                    <div class="pd-item-icon">⌖</div>
                    <div class="pd-item-content">
                        <div class="pd-item-name">@sube.Ad <span class="pd-mini-badge @(sube.Durum == "Aktif" ? "" : "off")">@sube.Durum</span></div>
                        <div class="pd-item-detail">@sube.Il / @sube.Ilce</div>
                        @if (!string.IsNullOrWhiteSpace(sube.Adres))
                        {
                            <div class="pd-item-detail">@sube.Adres</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(sube.Telefon))
                        {
                            <div class="pd-item-detail">☎ @sube.Telefon</div>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="pd-panel pd-section pd-wide">
            <h2 class="pd-section-title">✂ Hizmetler ve Fiyatlar (@hizmetler.Count)</h2>
            <p class="pd-section-sub">İşletmenin sunduğu hizmetler ve güncel fiyatları</p>
            @if (!hizmetler.Any())
            {
                <div class="pd-empty">Henüz hizmet tanımlanmamış.</div>
            }
            @foreach (var hizmet in hizmetler.OrderBy(x => x.Ad))
            {
                <div class="pd-item">
                    <div class="pd-item-icon">✂</div>
                    <div class="pd-item-content">
                        <div class="pd-item-name">@hizmet.Ad <span class="pd-mini-badge @(hizmet.AktifMi ? "" : "off")">@(hizmet.AktifMi ? "Aktif" : "Pasif")</span></div>
                        <div class="pd-item-detail">@hizmet.SureDakika dakika</div>
                        @if (!string.IsNullOrWhiteSpace(hizmet.Aciklama))
                        {
                            <div class="pd-item-detail">@hizmet.Aciklama</div>
                        }
                    </div>
                    <div class="pd-price">@hizmet.Fiyat.ToString("N2") ₺</div>
                </div>
            }
        </section>
    </div>

    @if (bekliyor)
    {
        <div class="alert alert-info mt-3 rounded-3">Başvuruyu onaylamak veya reddetmek için <a asp-controller="Platform" asp-action="Index" asp-fragment="basvurular">İşletme Başvuruları</a> bölümünü kullanın.</div>
    }
</div>
