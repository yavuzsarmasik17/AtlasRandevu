@using AtlasRandevu.Domain.Entities
@using System.Linq
@{
    Layout = "_IsletmeLayout";
    ViewData["Title"] = "Günlük Personel Takvimi";

    var subeler = ViewBag.Subeler as List<Sube> ?? new List<Sube>();
    var personeller = ViewBag.Personeller as List<Personel> ?? new List<Personel>();
    var randevular = ViewBag.Randevular as List<Randevu> ?? new List<Randevu>();
    var kapaliZamanlar = ViewBag.KapaliZamanlar as List<PersonelKapaliZaman> ?? new List<PersonelKapaliZaman>();
    int? seciliSubeId = ViewBag.SeciliSubeId as int?;
    DateTime gun = ViewBag.Tarih is DateTime t ? t.Date : DateTime.Today;
    var calismaSaati = ViewBag.CalismaSaati as SubeCalismaSaati;
    var hizmetler = ViewBag.Hizmetler as List<Hizmet> ?? new List<Hizmet>();
    int? seciliHizmetId = ViewBag.SeciliHizmetId as int?;
    var seciliHizmet = hizmetler.FirstOrDefault(x => x.Id == seciliHizmetId);
    int seciliSure = seciliHizmet?.SureDakika ?? 15;
    bool subeAcik = calismaSaati != null && calismaSaati.AcikMi && calismaSaati.Kapanis > calismaSaati.Acilis;
    var saatler = Enumerable.Range(0, 96).Select(i => gun.AddMinutes(i * 15)).Where(x => x.Hour >= 7 && x.Hour < 23).ToList();
}

<style>
    .takvim-page {
        max-width: 1500px;
        margin: 0 auto;
        color: #182c4a;
    }

    .takvim-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 18px;
    }

        .takvim-head h1 {
            font-size: 26px;
            margin: 0;
            font-weight: 800;
        }

    .takvim-panel {
        background: white;
        border: 1px solid #e4eaf3;
        border-radius: 15px;
        padding: 18px;
        margin-bottom: 16px;
    }

    .takvim-filtre {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: end;
    }

        .takvim-filtre label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .takvim-filtre select, .takvim-filtre input {
            border: 1px solid #cfd9e8;
            border-radius: 8px;
            padding: 9px;
            min-height: 40px;
        }

    .takvim-btn {
        display: inline-block;
        padding: 10px 14px;
        border-radius: 9px;
        border: 0;
        background: #2563eb;
        color: white;
        text-decoration: none;
        cursor: pointer;
        font-weight: 700;
    }

        .takvim-btn.ikincil {
            background: #eaf0ff;
            color: #244a9b;
        }

    .takvim-scroll {
        overflow-x: auto;
        border: 1px solid #e4eaf3;
        border-radius: 14px;
        background: white;
    }

    .takvim-grid {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 680px;
        table-layout: fixed;
    }

        .takvim-grid th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #f4f7fc;
            border-bottom: 1px solid #dae3f0;
            padding: 12px 8px;
            text-align: center;
        }

            .takvim-grid th:first-child {
                width: 78px;
            }

        .takvim-grid td {
            border-bottom: 1px solid #edf1f7;
            border-right: 1px solid #edf1f7;
            padding: 3px;
            height: 46px;
            vertical-align: top;
        }

    .takvim-saat {
        background: #f8faff;
        text-align: center;
        font-weight: 700;
        font-size: 12px;
        white-space: nowrap;
        padding-top: 13px !important;
    }

    .takvim-kayit {
        border-radius: 7px;
        padding: 5px 6px;
        font-size: 11px;
        line-height: 1.35;
        overflow-wrap: anywhere;
        margin-bottom: 3px;
    }

        .takvim-kayit.randevu {
            background: #dbeafe;
            color: #1e40af;
            border-left: 3px solid #2563eb;
        }

        .takvim-kayit.kapali {
            background: #f1f2f5;
            color: #525d70;
            border-left: 3px solid #8792a5;
        }

        .takvim-kayit small {
            display: block;
            margin-top: 2px;
        }


        .takvim-kayit.onaybekliyor {
            background: #fef3c7;
            color: #92400e;
            border-left-color: #d97706;
        }

        .takvim-kayit.geldi {
            background: #dcfce7;
            color: #166534;
            border-left-color: #16a34a;
        }

        .takvim-kayit.tamamlandi {
            background: #e9d5ff;
            color: #6b21a8;
            border-left-color: #9333ea;
        }

        .takvim-kayit.randevu.tiklanabilir {
            cursor: pointer;
            width: 100%;
            text-align: left;
            border-top: 0;
            border-right: 0;
            border-bottom: 0;
            font-family: inherit;
        }

            .takvim-kayit.randevu.tiklanabilir:hover {
                filter: brightness(.95);
                outline: 2px solid #93c5fd;
            }

            .takvim-kayit.randevu.tiklanabilir:focus-visible {
                outline: 3px solid #2563eb;
            }

    .detay-arka {
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: rgba(15,23,42,.65);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

        .detay-arka.acik {
            display: flex;
        }

    .detay-kutu {
        width: 100%;
        max-width: 520px;
        max-height: 90vh;
        overflow-y: auto;
        background: #fff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 20px 55px rgba(0,0,0,.2);
    }

    .detay-ust {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 15px;
    }

        .detay-ust h2 {
            margin: 0;
            font-size: 21px;
        }

    .detay-kapat {
        background: #f1f5f9;
        border: 0;
        border-radius: 8px;
        padding: 7px 12px;
        cursor: pointer;
    }

    .detay-satir {
        padding: 10px 0;
        border-bottom: 1px solid #edf1f7;
        display: grid;
        grid-template-columns: 130px 1fr;
        gap: 10px;
        font-size: 14px;
    }

        .detay-satir dt {
            color: #64748b;
            font-weight: 600;
        }

        .detay-satir dd {
            margin: 0;
            overflow-wrap: anywhere;
        }

    .detay-islemler {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
        align-items: center;
    }

        .detay-islemler form {
            margin: 0;
        }

        .detay-islemler [hidden] {
            display: none !important;
        }

    .takvim-btn.basarili {
        background: #15803d;
    }

    .takvim-btn.tehlike {
        background: #b91c1c;
    }

    .takvim-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 10px 0;
        font-size: 12px;
    }

        .takvim-legend span {
            padding: 5px 9px;
            border-radius: 6px;
            background: #f4f7fc;
        }

    .takvim-bos {
        color: #b4bece;
        text-align: center;
        padding-top: 10px;
    }

    .takvim-musait {
        display: block;
        width: 100%;
        min-height: 38px;
        padding: 10px 5px;
        border-radius: 7px;
        background: #e8f8ef;
        color: #168457;
        text-align: center;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: background .2s;
    }

        .takvim-musait:hover {
            background: #c9f0da;
            color: #087348;
        }

    .takvim-gecmis {
        color: #b4bece;
        text-align: center;
        padding-top: 10px;
    }


    .takvim-aciklama {
        color: #6e7f99;
        font-size: 13px;
    }

    @@media(max-width:650px) {
        .takvim-head h1 {
            font-size: 22px;
        }

        .takvim-panel {
            padding: 12px;
        }
    }
</style>

<div class="takvim-page">
    <div class="takvim-head">
        <div>
            <h1>Günlük Personel Takvimi</h1>
            <p class="takvim-aciklama">Online ve manuel randevuları, personelin kapalı saatleriyle birlikte görüntüleyin.</p>
        </div>
        <a asp-controller="IsletmeRandevular" asp-action="Index" class="takvim-btn ikincil">Randevu Yönetimine Dön</a>
    </div>

    @if (TempData["RandevuMesaj"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["RandevuMesaj"]</div>
    }
    @if (TempData["RandevuHata"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["RandevuHata"]</div>
    }

    <div class="takvim-panel">
        <form asp-controller="IsletmeTakvim" asp-action="Index" method="get" class="takvim-filtre">
            <div>
                <label for="subeId">Şube</label>
                <select name="subeId" id="subeId">
                    @foreach (var sube in subeler)
                    {
                        <option value="@sube.Id" selected="@(seciliSubeId == sube.Id)">@sube.Ad</option>
                    }
                </select>
            </div>
            <div>
                <label for="tarih">Tarih</label>
                <input type="date" name="tarih" id="tarih" value="@gun.ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label for="hizmetId">Uygunluk için hizmet</label>
                <select name="hizmetId" id="hizmetId">
                    <option value="">Hizmet seçilmedi (15 dk)</option>
                    @foreach (var hizmet in hizmetler)
                    {
                        <option value="@hizmet.Id" selected="@(seciliHizmetId == hizmet.Id)">@hizmet.Ad (@hizmet.SureDakika dk)</option>
                    }
                </select>
            </div>
            <button type="submit" class="takvim-btn">Takvimi Göster</button>
            <a asp-controller="IsletmeManuelRandevu" asp-action="Ekle" class="takvim-btn ikincil">+ Manuel Randevu</a>
            <a asp-controller="IsletmeKapaliZamanlar" asp-action="Index" class="takvim-btn ikincil">Saati Kapat</a>
        </form>
    </div>

    @if (subeler.Any() && !subeAcik)
    {
        <div class="takvim-panel">Bu gün için şube kapalı veya çalışma saati tanımlanmamış. Yeni randevu bağlantıları kapatıldı; mevcut kayıtlar gösterilmeye devam ediyor.</div>
    }
    else if (subeAcik)
    {
        <p class="takvim-aciklama">Şube çalışma saatleri: @calismaSaati!.Acilis.ToString(@"hh\:mm") – @calismaSaati.Kapanis.ToString(@"hh\:mm")</p>
    }

    <div class="takvim-legend" aria-label="Takvim renkleri">
        <span>🔵 Onaylandı</span><span>🟡 Onay bekliyor</span><span>🟢 Geldi</span>
        <span>🟣 Tamamlandı</span><span>⬜ Kapalı zaman</span><span>🟩 Müsait</span>
    </div>
    <p class="takvim-aciklama">@(seciliHizmet == null ? "15 dakikalık başlangıç boşlukları gösteriliyor. Kesin uygunluk için hizmet seçin." : $"{seciliHizmet.Ad} için {seciliSure} dakikalık uygunluk kontrol ediliyor.")</p>

    @if (!subeler.Any())
    {
        <div class="takvim-panel">Aktif şube bulunamadı.</div>
    }
    else if (!personeller.Any())
    {
        <div class="takvim-panel">Seçilen şubede aktif personel bulunamadı.</div>
    }
    else
    {
        <div class="takvim-scroll">
            <table class="takvim-grid">
                <thead>
                    <tr>
                        <th>Saat</th>
                        @foreach (var personel in personeller)
                        {
                            <th>@personel.AdSoyad</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in saatler)
                    {
                        var slotBitis = slot.AddMinutes(15);
                        <tr>
                            <td class="takvim-saat">@slot.ToString("HH:mm")</td>
                            @foreach (var personel in personeller)
                            {
                                var baslayanRandevular = randevular.Where(x => x.PersonelId == personel.Id && x.BaslangicTarihi >= slot && x.BaslangicTarihi < slotBitis).ToList();
                                var baslayanKapali = kapaliZamanlar.Where(x => x.PersonelId == personel.Id && x.BaslangicTarihi >= slot && x.BaslangicTarihi < slotBitis).ToList();
                                var surenRandevu = randevular.Any(x => (x.PersonelId == personel.Id || x.PersonelId == null) && x.BaslangicTarihi < slot && x.BitisTarihi > slot);
                                var surenKapali = kapaliZamanlar.Any(x => x.PersonelId == personel.Id && x.BaslangicTarihi < slot && x.BitisTarihi > slot);
                                var slotDolu = randevular.Any(x =>
                                (x.PersonelId == personel.Id || x.PersonelId == null) &&
                                x.BaslangicTarihi < slotBitis &&
                                x.BitisTarihi > slot);

                                var slotKapali = kapaliZamanlar.Any(x =>
                                x.PersonelId == personel.Id &&
                                x.BaslangicTarihi < slotBitis &&
                                x.BitisTarihi > slot);

                                var hizmetBitis = slot.AddMinutes(seciliSure);
                                var sureBoyuncaDolu = randevular.Any(x =>
                                (x.PersonelId == personel.Id || x.PersonelId == null) &&
                                (x.Durum == "OnayBekliyor" || x.Durum == "Onaylandi" || x.Durum == "Geldi") &&
                                x.BaslangicTarihi < hizmetBitis && x.BitisTarihi > slot);
                                var sureBoyuncaKapali = kapaliZamanlar.Any(x =>
                                x.PersonelId == personel.Id &&
                                x.BaslangicTarihi < hizmetBitis && x.BitisTarihi > slot);
                                var slotCalismaSaatinde = subeAcik &&
                                slot.TimeOfDay >= calismaSaati!.Acilis &&
                                hizmetBitis.Date == slot.Date &&
                                hizmetBitis.TimeOfDay <= calismaSaati.Kapanis &&
                                (slot.TimeOfDay - calismaSaati.Acilis).Ticks % TimeSpan.FromMinutes(15).Ticks == 0;
                                var slotMusait = !sureBoyuncaDolu && !sureBoyuncaKapali &&
                                slotCalismaSaatinde && slot > DateTime.Now;
                                <td>
                                    @foreach (var r in baslayanRandevular)
                                    {
                                        <button type="button"
                                                class="takvim-kayit randevu tiklanabilir @(r.Durum == "OnayBekliyor" ? "onaybekliyor" : r.Durum == "Geldi" ? "geldi" : r.Durum == "Tamamlandi" ? "tamamlandi" : "")"
                                                data-randevu-id="@r.Id"
                                                data-musteri="@(string.IsNullOrWhiteSpace(r.ManuelMusteriAdi) ? "Online müşteri" : r.ManuelMusteriAdi)"
                                                data-telefon="@r.ManuelMusteriTelefonu"
                                                data-personel="@personel.AdSoyad"
                                                data-hizmet="@(hizmetler.FirstOrDefault(h => h.Id == r.HizmetId)?.Ad ?? "Hizmet bilgisi yok")"
                                                data-tarih="@r.BaslangicTarihi.ToString("dd.MM.yyyy")"
                                                data-saat="@r.BaslangicTarihi.ToString("HH:mm") – @r.BitisTarihi.ToString("HH:mm")"
                                                data-kaynak="@r.RandevuKaynagi"
                                                data-durum="@r.Durum"
                                                data-duzenlenebilir="@((r.RandevuKaynagi == "Telefon" || r.RandevuKaynagi == "Elden") && r.MusteriKullaniciId == null && r.Durum == "Onaylandi" && r.BaslangicTarihi > DateTime.Now ? "true" : "false")"
                                                aria-label="Randevu detaylarını aç">
                                            <strong>@r.BaslangicTarihi.ToString("HH:mm")–@r.BitisTarihi.ToString("HH:mm")</strong>
                                            <small>@(string.IsNullOrWhiteSpace(r.ManuelMusteriAdi) ? "Online randevu" : r.ManuelMusteriAdi)</small>
                                            <small>@r.Durum · Detay</small>
                                        </button>
                                    }
                                    @foreach (var k in baslayanKapali)
                                    {
                                        <div class="takvim-kayit kapali">
                                            <strong>@k.BaslangicTarihi.ToString("HH:mm")–@k.BitisTarihi.ToString("HH:mm")</strong>
                                            <small>@(string.IsNullOrWhiteSpace(k.Aciklama) ? "Kapalı saat" : k.Aciklama)</small>
                                        </div>
                                    }
                                    @if (!baslayanRandevular.Any() && !baslayanKapali.Any())
                                    {
                                        @if (surenRandevu || surenKapali || slotDolu || slotKapali)
                                        {
                                            <div class="takvim-bos">·</div>
                                        }
                                        else if (slotMusait && seciliSubeId.HasValue)
                                        {
                                            <a asp-controller="IsletmeManuelRandevu"
                                               asp-action="Ekle"
                                               asp-route-subeId="@seciliSubeId.Value"
                                               asp-route-personelId="@personel.Id"
                                               asp-route-tarih="@slot.ToString("yyyy-MM-dd")"
                                               asp-route-saat="@slot.ToString("HH:mm")"
                                               asp-route-hizmetId="@seciliHizmetId"
                                               class="takvim-musait"
                                               title="Bu saate manuel randevu ekle">
                                                + Randevu Ekle
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="takvim-gecmis">—</div>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="takvim-aciklama" style="margin-top:10px">Renkler randevu durumlarını gösterir. Yeşil bağlantılar seçili hizmetin süresine göre hesaplanır. Kayıtlar başladıkları 15 dakikalık satırda gösterilir; sonraki satırlardaki nokta devam eden süreyi belirtir. Görünüm 07:00–23:00 arasındadır.</p>
    }
</div>

<div id="randevuDetayArka" class="detay-arka" aria-hidden="true">
    <section class="detay-kutu" role="dialog" aria-modal="true" aria-labelledby="randevuDetayBaslik">
        <div class="detay-ust">
            <h2 id="randevuDetayBaslik">Randevu Detayları</h2>
            <button id="detayKapat" type="button" class="detay-kapat" aria-label="Pencereyi kapat">✕</button>
        </div>
        <dl>
            <div class="detay-satir"><dt>Müşteri</dt><dd id="detayMusteri"></dd></div>
            <div class="detay-satir"><dt>Telefon</dt><dd id="detayTelefon"></dd></div>
            <div class="detay-satir"><dt>Personel</dt><dd id="detayPersonel"></dd></div>
            <div class="detay-satir"><dt>Hizmet</dt><dd id="detayHizmet"></dd></div>
            <div class="detay-satir"><dt>Tarih</dt><dd id="detayTarih"></dd></div>
            <div class="detay-satir"><dt>Saat</dt><dd id="detaySaat"></dd></div>
            <div class="detay-satir"><dt>Kaynak</dt><dd id="detayKaynak"></dd></div>
            <div class="detay-satir"><dt>Durum</dt><dd id="detayDurum"></dd></div>
        </dl>
        <div class="detay-islemler">
            <a id="detayDuzenle" class="takvim-btn" href="#" hidden>Düzenle</a>
            <form id="formManuelGeldi" asp-controller="IsletmeRandevular" asp-action="ManuelGeldi" method="post" hidden>
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="" />
                <input type="hidden" name="returnUrl" value="" />
                <button type="submit" class="takvim-btn basarili">Müşteri Geldi</button>
            </form>
            <form id="formTamamla" asp-controller="IsletmeRandevular" asp-action="Tamamla" method="post" hidden>
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="" />
                <input type="hidden" name="returnUrl" value="" />
                <button type="submit" class="takvim-btn basarili">Tamamla</button>
            </form>
            <form id="formManuelIptal" asp-controller="IsletmeRandevular" asp-action="ManuelIptal" method="post" hidden>
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="" />
                <input type="hidden" name="returnUrl" value="" />
                <button type="submit" class="takvim-btn tehlike" onclick="return confirm('Bu manuel randevuyu iptal etmek istiyor musunuz?');">İptal Et</button>
            </form>
            <a asp-controller="IsletmeRandevular" asp-action="Index" class="takvim-btn ikincil">Randevu Yönetimi</a>
        </div>
    </section>
</div>
<script>
    (function () {
        const arka = document.getElementById('randevuDetayArka');
        const kapat = document.getElementById('detayKapat');
        const duzenle = document.getElementById('detayDuzenle');
        const geldiForm = document.getElementById('formManuelGeldi');
        const tamamlaForm = document.getElementById('formTamamla');
        const iptalForm = document.getElementById('formManuelIptal');
        let oncekiOdak = null;
        const alanlar = ['Musteri', 'Telefon', 'Personel', 'Hizmet', 'Tarih', 'Saat', 'Kaynak', 'Durum'];
        const duzenleTemel = '@Url.Action("Duzenle", "IsletmeManuelRandevu")';
        document.querySelectorAll('.takvim-kayit.tiklanabilir').forEach(btn => {
            btn.addEventListener('click', function () {
                oncekiOdak = btn;
                alanlar.forEach(ad => {
                    const anahtar = ad.charAt(0).toLowerCase() + ad.slice(1);
                    document.getElementById('detay' + ad).textContent = btn.dataset[anahtar] || '—';
                });
                const uygun = btn.dataset.duzenlenebilir === 'true';
                duzenle.hidden = !uygun;
                if (uygun) duzenle.href = duzenleTemel + '?id=' + encodeURIComponent(btn.dataset.randevuId);
                const manuel = btn.dataset.manuel === 'true';
                const durum = btn.dataset.durum;
                const simdi = new Date();
                const baslangic = new Date(btn.dataset.baslangic);
                const bitis = new Date(btn.dataset.bitis);
                geldiForm.hidden = !(manuel && durum === 'Onaylandi' && baslangic <= simdi && bitis >= simdi);
                tamamlaForm.hidden = !(durum === 'Geldi' && bitis <= simdi);
                iptalForm.hidden = !(manuel && durum === 'Onaylandi' && baslangic > simdi);
                [geldiForm, tamamlaForm, iptalForm].forEach(form => {
                    form.querySelector('input[name="id"]').value = btn.dataset.randevuId;
                    form.querySelector('input[name="returnUrl"]').value = window.location.pathname + window.location.search;
                });
                arka.classList.add('acik');
                arka.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
                kapat.focus();
            });
        });
        function pencereyiKapat() {
            arka.classList.remove('acik');
            arka.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            if (oncekiOdak) oncekiOdak.focus();
        }
        kapat.addEventListener('click', pencereyiKapat);
        arka.addEventListener('click', e => { if (e.target === arka) pencereyiKapat(); });
        document.addEventListener('keydown', e => {
            if (!arka.classList.contains('acik')) return;
            if (e.key === 'Escape') pencereyiKapat();
            if (e.key === 'Tab') {
                const odaklanabilir = Array.from(arka.querySelectorAll('button, a[href]')).filter(x => !x.hidden && !x.closest('[hidden]'));
                const ilk = odaklanabilir[0], son = odaklanabilir[odaklanabilir.length - 1];
                if (e.shiftKey && document.activeElement === ilk) { e.preventDefault(); son.focus(); }
                else if (!e.shiftKey && document.activeElement === son) { e.preventDefault(); ilk.focus(); }
            }
        });
    })();
</script>
