@{
    Layout = "_KayitLayout";
    ViewData["Title"] = "Başvuru Alındı";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm mx-auto"
         style="max-width:650px; border-radius:20px;">

        <div class="card-body text-center p-5">

            <div class="mb-4"
                 style="font-size:65px;">
                ✓
            </div>

            <h2 class="fw-bold mb-3">
                Başvurunuz Alındı!
            </h2>

            <p class="text-muted mb-4">
                Atlas Randevu işletme kayıt başvurunuz
                başarıyla oluşturuldu.
            </p>

            <div class="alert alert-info text-start">
                <strong>Başvurunuz inceleniyor.</strong>
                <p class="mb-0 mt-2">
                    Vergi levhanız ve işletme bilgileriniz
                    yönetim ekibimiz tarafından kontrol
                    edilecektir.
                </p>
            </div>

            <p class="text-muted">
                İşletmeniz onaylandıktan sonra
                yönetim panelinizi kullanabileceksiniz.
            </p>

            <a href="/"
               class="btn btn-primary px-4 py-2 mt-3">
                Ana Sayfaya Dön
            </a>

        </div>
    </div>
</div>
