@model AtlasRandevu.Web.Controllers.PlatformAdminHesapModel
@{
    Layout = "_PlatformLayout";
    ViewData["Title"] = "Platform Admin Hesabı";
}
<div class="container py-4" style="max-width:680px">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-md-5">
            <h2 class="h4 fw-bold mb-2">Yönetici Hesap Bilgileri</h2>
            <p class="text-muted">E-posta adresini ve şifreni birlikte değiştir. İşlem sonunda yeniden giriş yapacaksın.</p>
            <form asp-controller="PlatformAdminHesap" asp-action="Index" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="YeniEposta" class="form-label">Yeni giriş e-postası</label>
                    <input asp-for="YeniEposta" class="form-control" autocomplete="email" />
                    <span asp-validation-for="YeniEposta" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MevcutSifre" class="form-label">Mevcut şifre</label>
                    <input asp-for="MevcutSifre" class="form-control" type="password" autocomplete="current-password" />
                    <span asp-validation-for="MevcutSifre" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="YeniSifre" class="form-label">Yeni şifre</label>
                    <input asp-for="YeniSifre" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="YeniSifre" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="YeniSifreTekrar" class="form-label">Yeni şifre tekrar</label>
                    <input asp-for="YeniSifreTekrar" class="form-control" type="password" autocomplete="new-password" />
                    <span asp-validation-for="YeniSifreTekrar" class="text-danger"></span>
                </div>
                <p class="small text-muted">Şifre en az 8 karakter; büyük/küçük harf, rakam ve özel karakter içermelidir.</p>
                <button type="submit" class="btn btn-primary">Bilgileri Güncelle</button>
            </form>
        </div>
    </div>
</div>
