@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using AtlasRandevu.Infrastructure.Persistence
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject AtlasRandevuDbContext Db

@{
    var girisYapildi = SignInManager.IsSignedIn(User);
    var platformYoneticisi = girisYapildi &&
        User.IsInRole("PlatformAdmin");

    var isletmeSahibi = false;

    if (girisYapildi && !platformYoneticisi)
    {
        var kullaniciId = UserManager.GetUserId(User);

        isletmeSahibi = await Db.IsletmeKullanicilari
            .AsNoTracking()
            .AnyAsync(x =>
                x.KullaniciId == kullaniciId &&
                x.AktifMi &&
                x.Rol == "IsletmeSahibi");
    }

    var musteri = girisYapildi &&
        !platformYoneticisi &&
        !isletmeSahibi &&
        User.IsInRole("Musteri");


    var kullaniciAdi = User.Identity?.Name ?? "Hesabım";

    if (musteri)
    {
        var kullaniciId = UserManager.GetUserId(User);

        var profil = await Db.MusteriProfilleri
            .AsNoTracking()
            .Where(x => x.KullaniciId == kullaniciId)
            .Select(x => new { x.Ad, x.Soyad })
            .FirstOrDefaultAsync();

        if (profil != null)
        {
            var adSoyad = $"{profil.Ad} {profil.Soyad}".Trim();

            if (!string.IsNullOrWhiteSpace(adSoyad))
                kullaniciAdi = adSoyad;
        }
    }

    var adParcalari = kullaniciAdi.Split(
        ' ', StringSplitOptions.RemoveEmptyEntries);

    var basHarfler = adParcalari.Length >= 2
        ? $"{adParcalari[0][0]}{adParcalari[^1][0]}".ToUpperInvariant()
        : kullaniciAdi.Length > 0
            ? kullaniciAdi.Substring(0, 1).ToUpperInvariant()
            : "Ü";

}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />


    <title>@(ViewData["Title"] ?? "Online Randevu Al") - ATLAS Randevu</title>

    <meta name="description"
          content="@(ViewData["Description"] ?? "ATLAS Randevu ile berber, kuaför ve güzellik salonlarını keşfet. Hizmetleri incele ve online randevunu kolayca oluştur.")" />

    <meta name="robots" content="index, follow" />

    <link rel="icon"
          type="image/png"
          href="~/images/atlas-randevu-logo.png"
          asp-append-version="true" />

    <link rel="icon"
          type="image/png"
          href="~/images/atlas-randevu-logo.png"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AtlasRandevu.Web.styles.css"
          asp-append-version="true" />

    <style>

        .atlas-logo {
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .atlas-logo-img {
            width: 42px;
            height: 42px;
            object-fit: contain;
            flex-shrink: 0;
        }

        body {
            background: #f8fafc;
            color: #172033;
        }

        .atlas-navbar {
            background: #fff;
            border-bottom: 1px solid #e9edf3;
            box-shadow: 0 3px 16px rgba(15,23,42,.04);
        }

        .atlas-logo {
            font-size: 1.35rem;
            font-weight: 850;
            letter-spacing: -.65px;
            color: #2563eb !important;
            white-space: nowrap;
            text-decoration: none;
        }

            .atlas-logo span {
                color: #172033;
            }

        .atlas-navbar .navbar-toggler {
            color: #172033;
            border: 1px solid #dbe3ef;
            border-radius: 10px;
            padding: 8px 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .atlas-navbar .navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(37,99,235,.16);
            }

        @@media (min-width: 992px) {
            .atlas-navbar .navbar-toggler

        {
            display: none;
        }

        }

        .atlas-login-menu {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            margin-left: auto;
        }

        .atlas-navbar .nav-link {
            color: #475569;
            font-weight: 600;
            text-decoration: none;
        }

            .atlas-navbar .nav-link:hover {
                color: #2563eb;
            }

        .atlas-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #2563eb;
            color: #fff !important;
            border-radius: 12px;
            padding: 11px 19px !important;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
            transition: .2s ease;
            border: 1px solid #2563eb;
        }

            .atlas-btn:hover {
                background: #1d4ed8;
                transform: translateY(-1px);
            }

        .atlas-outline-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #dbe3ef;
            border-radius: 12px;
            padding: 11px 19px !important;
            color: #1e3a5f !important;
            background: #fff;
            text-decoration: none;
            font-weight: 700;
            white-space: nowrap;
            transition: .2s ease;
        }

            .atlas-outline-btn:hover {
                background: #f1f5ff;
                border-color: #bfcefa;
                transform: translateY(-1px);
            }

        .atlas-platform-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #14213d;
            color: #fff !important;
            border: 1px solid #14213d;
            border-radius: 12px;
            padding: 11px 19px !important;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
            transition: .2s ease;
        }

            .atlas-platform-btn:hover {
                background: #253b68;
                transform: translateY(-1px);
            }

        .atlas-dropdown {
            border: 1px solid #e8edf6;
            border-radius: 14px;
            padding: 8px;
            box-shadow: 0 16px 40px rgba(15,23,42,.12);
            min-width: 220px;
        }

            .atlas-dropdown .dropdown-item {
                border-radius: 9px;
                padding: 11px 13px;
                font-weight: 600;
                color: #26364d;
            }

                .atlas-dropdown .dropdown-item:hover {
                    background: #eef3ff;
                    color: #2458da;
                }

        .atlas-main {
            min-height: calc(100vh - 190px);
        }

        .atlas-footer {
            background: #fff;
            border-top: 1px solid #e9edf3;
            padding: 25px 0;
            color: #64748b;
            font-size: .9rem;
        }

        @@media (max-width: 991.98px) {
            .atlas-navbar .navbar-collapse {
                padding: 16px 0 8px;
            }

            .atlas-login-menu {
                flex-direction: column;
                align-items: stretch;
                gap: 9px;
                width: 100%;
            }

            .atlas-btn,
            .atlas-outline-btn,
            .atlas-platform-btn {
                width: 100%;
                text-align: center;
            }
        }


        .atlas-member-link {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 11px 16px;
            border: 1px solid #e0e8f5;
            border-radius: 13px;
            background: #fff;
            color: #213654;
            text-decoration: none;
            font-size: 13px;
            font-weight: 750;
            white-space: nowrap;
            transition: .2s ease;
        }

            .atlas-member-link:hover {
                background: #eff5ff;
                border-color: #b8cbf9;
                color: #2563eb;
            }

        .atlas-member-icon {
            font-size: 17px;
            color: #2563eb;
        }

        .atlas-member-account {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            padding: 7px 13px 7px 7px;
            border: 1px solid #e0e8f5;
            border-radius: 14px;
            background: #fff;
            color: #213654;
            text-decoration: none;
        }

        .atlas-member-avatar {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            background: linear-gradient(135deg,#2563eb,#6c63ff);
            color: white;
            font-size: 13px;
            font-weight: 850;
        }

        .atlas-member-name {
            display: block;
            font-size: 13px;
            font-weight: 800;
            line-height: 1.3;
        }

        .atlas-member-role {
            display: block;
            font-size: 10px;
            color: #8391a9;
        }

    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg atlas-navbar">
            <div class="container py-2">

                <a class="navbar-brand atlas-logo"
                   asp-controller="Kesfet"
                   asp-action="Index">

                    <img src="~/images/atlas-randevu-logo.png"
                         asp-append-version="true"
                         alt="Atlas Randevu"
                         class="atlas-logo-img" />

                    ATLAS <span>RANDEVU</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#atlasMenu"
                        aria-controls="atlasMenu"
                        aria-expanded="false"
                        aria-label="Menüyü aç">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                        <path d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <div class="collapse navbar-collapse"
                     id="atlasMenu">

                    @if (!girisYapildi)
                    {
                        <div class="atlas-login-menu">

                            <a class="atlas-btn"
                               asp-controller="Hesap"
                               asp-action="Giris"
                               asp-route-girisTipi="musteri">
                                Üye Girişi
                            </a>

                            <a class="atlas-outline-btn"
                               asp-controller="Hesap"
                               asp-action="Giris"
                               asp-route-girisTipi="isletme">
                                İşletme Girişi
                            </a>

                            <a class="atlas-platform-btn"
                               asp-controller="Hesap"
                               asp-action="Giris"
                               asp-route-girisTipi="yonetici">
                                Platform Girişi
                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="atlas-login-menu">

                            @if (platformYoneticisi)
                            {
                                <a class="atlas-platform-btn"
                                   asp-controller="Platform"
                                   asp-action="Index">
                                    Platform Yönetimi
                                </a>
                            }
                            else if (isletmeSahibi)
                            {
                                <a class="atlas-btn"
                                   asp-controller="IsletmePanel"
                                   asp-action="Index">
                                    İşletme Panelim
                                </a>
                            }

                            else if (musteri)
                            {
                                <a class="atlas-member-link"
                                   asp-controller="Randevularim"
                                   asp-action="Index">
                                    <span class="atlas-member-icon">▦</span>
                                    Randevularım
                                </a>

                                <a class="atlas-member-link"
                                   asp-controller="MusteriYorum"
                                   asp-action="Index">
                                    <span class="atlas-member-icon">★</span>
                                    Değerlendirmelerim
                                </a>
                            }


                            <div class="dropdown">

                                <a class="atlas-member-account dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <span class="atlas-member-avatar">
                                        @basHarfler
                                    </span>

                                    <span>
                                        <span class="atlas-member-name">@kullaniciAdi</span>
                                        <span class="atlas-member-role">
                                            @(musteri ? "Üye Hesabı" :
                                                platformYoneticisi ? "Platform Yöneticisi" :
                                                "İşletme Sahibi")
                                        </span>
                                    </span>
                                </a>


                                <ul class="dropdown-menu dropdown-menu-end atlas-dropdown">
                                    @if (platformYoneticisi)
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="PlatformAdminHesap"
                                               asp-action="Index">Hesap Ayarlarım</a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li>
                                        <form asp-controller="Hesap"
                                              asp-action="Cikis"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item">
                                                Çıkış Yap
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>

                        </div>
                    }

                </div>
            </div>
        </nav>
    </header>

    <div class="container atlas-main py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="atlas-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year Atlas Randevu</span>
            <span>Atlas Soft</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
