@{
    var sayfaBasligi = ViewData["Title"]?.ToString() ?? "Yönetim";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isletmelerAktif = controller == "PlatformIsletmeler";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@sayfaBasligi - Atlas Randevu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --atlas-navy: #111b32;
            --atlas-blue: #2563eb;
            --atlas-bg: #f4f7fc;
            --atlas-text: #17233d;
            --atlas-muted: #8490a5
        }

        body {
            margin: 0;
            background: var(--atlas-bg);
            color: var(--atlas-text);
            font-family: 'Segoe UI',Arial,sans-serif
        }

        .atlas-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 255px;
            background: var(--atlas-navy);
            color: white;
            z-index: 1040;
            overflow-y: auto;
            padding: 28px 15px
        }

        .atlas-brand {
            display: block;
            padding: 5px 15px 32px;
            color: white;
            text-decoration: none;
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -.6px
        }

            .atlas-brand span {
                color: #60a5fa
            }

        .atlas-menu-title {
            color: #74829e;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            padding: 12px 16px
        }

        .atlas-sidebar .atlas-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px 16px;
            margin-bottom: 5px;
            border-radius: 12px;
            color: #b7c3da;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: .2s
        }

            .atlas-sidebar .atlas-nav-link:hover {
                color: white;
                background: #1d2b49
            }

            .atlas-sidebar .atlas-nav-link.active {
                color: white;
                background: var(--atlas-blue)
            }

            .atlas-sidebar .atlas-nav-link[aria-disabled="true"] {
                opacity: .5;
                cursor: default
            }

        .atlas-nav-icon {
            width: 22px;
            text-align: center;
            font-size: 18px
        }

        .atlas-main {
            margin-left: 255px;
            min-height: 100vh
        }

        .atlas-topbar {
            height: 82px;
            background: white;
            border-bottom: 1px solid #e8edf5;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px
        }

        .atlas-topbar-title {
            font-size: 18px;
            font-weight: 700
        }

        .atlas-profile {
            display: flex;
            align-items: center;
            gap: 12px
        }

        .atlas-avatar {
            width: 42px;
            height: 42px;
            border-radius: 13px;
            background: #e8efff;
            color: var(--atlas-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800
        }

        .atlas-content {
            padding: 32px 35px
        }

        .atlas-footer {
            padding: 20px 35px;
            color: #9aa5b6;
            font-size: 12px;
            text-align: center
        }

        .atlas-mobile-toggle, .atlas-overlay {
            display: none
        }

        @@media(max-width:991px) {
            .atlas-sidebar {
                transform: translateX(-100%);
                transition: transform .25s
            }

                .atlas-sidebar.open {
                    transform: translateX(0)
                }

            .atlas-main {
                margin-left: 0
            }

            .atlas-mobile-toggle {
                display: inline-flex
            }

            .atlas-topbar {
                padding: 0 18px;
                height: 70px
            }

            .atlas-content {
                padding: 22px 15px
            }

            .atlas-overlay.open {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.45);
                z-index: 1030
            }
        }
    </style>
</head>
<body>
    <div id="atlasOverlay" class="atlas-overlay" onclick="toggleAtlasMenu()"></div>
    <aside id="atlasSidebar" class="atlas-sidebar">
        <a asp-controller="Platform" asp-action="Index" class="atlas-brand">ATLAS <span>RANDEVU</span></a>
        <div class="atlas-menu-title">PLATFORM</div>
        <a asp-controller="Platform" asp-action="Index" class="atlas-nav-link @(controller == "Platform" ? "active" : "")"><span class="atlas-nav-icon">▦</span>Genel Bakış</a>
        <a asp-controller="Platform" asp-action="Index" asp-fragment="basvurular" class="atlas-nav-link"><span class="atlas-nav-icon">▤</span>İşletme Başvuruları</a>
        <div class="atlas-menu-title mt-4">YÖNETİM</div>
        <a asp-controller="PlatformIsletmeler" asp-action="Index" class="atlas-nav-link @(isletmelerAktif ? "active" : "")"><span class="atlas-nav-icon">▣</span>İşletmeler</a>

        <a asp-controller="PlatformMusteriler"
           asp-action="Index"
           class="atlas-nav-link @(controller == "PlatformMusteriler" ? "active" : "")">
            <span class="atlas-nav-icon">♙</span>
            Müşteriler
        </a>


        <a asp-controller="PlatformRandevular"
           asp-action="Index"
           class="atlas-nav-link @(controller == "PlatformRandevular" ? "active" : "")">
            <span class="atlas-nav-icon">▦</span>
            Randevular
        </a>

        <a asp-controller="PlatformYorumlar" asp-action="Index"
           class="atlas-nav-link @(controller == "PlatformYorumlar" ? "active" : "")">
            <span class="atlas-nav-icon">☆</span>Yorumlar
        </a>
        <a asp-controller="PlatformAdminHesap"
           asp-action="Index"
           class="nav-link">
            <i class="bi bi-person-gear me-2"></i>
            Hesap Ayarlarım
        </a>
        <div class="atlas-menu-title mt-4">HESAP</div>
        <a asp-controller="Kesfet" asp-action="Index" class="atlas-nav-link"><span class="atlas-nav-icon">⌂</span>Siteyi Görüntüle</a>
        <form asp-controller="Hesap" asp-action="Cikis" method="post">@Html.AntiForgeryToken()<button type="submit" class="atlas-nav-link w-100 border-0 text-start" style="background:transparent"><span class="atlas-nav-icon">↪</span>Çıkış Yap</button></form>
    </aside>
    <div class="atlas-main">
        <header class="atlas-topbar"><div class="d-flex align-items-center gap-3"><button type="button" class="btn btn-outline-secondary atlas-mobile-toggle" onclick="toggleAtlasMenu()" aria-label="Menüyü aç">☰</button><div class="atlas-topbar-title">@sayfaBasligi</div></div><div class="atlas-profile"><div class="d-none d-sm-block text-end"><div class="fw-semibold small">Platform Yöneticisi</div><div class="text-muted" style="font-size:12px">@User.Identity?.Name</div></div><div class="atlas-avatar">A</div></div></header>
        <main class="atlas-content">@RenderBody()</main>
        <footer class="atlas-footer">© @DateTime.Now.Year Atlas Soft · Atlas Randevu Yönetim Platformu</footer>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>function toggleAtlasMenu(){document.getElementById('atlasSidebar').classList.toggle('open');document.getElementById('atlasOverlay').classList.toggle('open')}</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
