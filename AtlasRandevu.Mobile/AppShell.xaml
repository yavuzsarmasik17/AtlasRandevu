<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AtlasRandevu.Mobile"
    x:Class="AtlasRandevu.Mobile.AppShell"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#2563EB"
    Shell.TabBarTitleColor="#2563EB"
    Shell.TabBarUnselectedColor="#94A3B8">

    <!-- AÇILIŞ -->
    <ShellContent
        Route="Acilis"
        ContentTemplate="{DataTemplate local:MainPage}" />

    <!-- GİRİŞ SEÇİMİ -->
    <ShellContent
        Route="Kesfet"
        ContentTemplate="{DataTemplate local:KesfetPage}" />

    <!-- MÜŞTERİ MENÜSÜ -->
    <TabBar Route="Musteri">

        <ShellContent
            Title="Ana Sayfa"
            Route="MusteriAnaSayfa"
            ContentTemplate="{DataTemplate local:BerberlerPage}" />

        <ShellContent
            Title="Randevularım"
            Route="Randevularim"
            ContentTemplate="{DataTemplate local:RandevularimPage}" />

        <ShellContent
            Title="Hesabım"
            Route="Hesabim"
            ContentTemplate="{DataTemplate local:HesabimPage}" />

    </TabBar>

</Shell>
