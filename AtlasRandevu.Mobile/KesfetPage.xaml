<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AtlasRandevu.Mobile.KesfetPage"
    BackgroundColor="#F5F7FB"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="22,48,22,30"
            Spacing="22">

            <!-- MARKA -->
            <HorizontalStackLayout Spacing="8">
                <Label
                    Text="✦"
                    FontSize="25"
                    TextColor="#2563EB" />

                <Label
                    Text="ATLAS RANDEVU"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="#142D5C"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- KARŞILAMA -->
            <Border
                StrokeThickness="0"
                BackgroundColor="#142D5C"
                StrokeShape="RoundRectangle 22"
                Padding="24">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="HOŞ GELDİNİZ"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="2"
                        TextColor="#A9C5FF" />

                    <Label
                        Text="Aradığın hizmet, doğru adres."
                        FontSize="29"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Randevularını kolayca oluştur, işletmeni tek yerden yönet."
                        FontSize="15"
                        TextColor="#DFE8FA" />

                </VerticalStackLayout>
            </Border>

            <Label
                Text="Nasıl devam etmek istersiniz?"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#142D5C" />

            <!-- MÜŞTERİ -->
            <Border
                BackgroundColor="White"
                Stroke="#DFE5EF"
                StrokeShape="RoundRectangle 18"
                Padding="20">

                <VerticalStackLayout Spacing="13">

                    <Label
                        Text="Müşteri Üye Girişi"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#142D5C" />

                    <Label
                        Text="Berberleri keşfet, hizmet seç ve randevularını kolayca yönet."
                        FontSize="14"
                        TextColor="#64748B" />

                    <Button
                        Text="Müşteri Olarak Devam Et →"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="52"
                        Clicked="Musteri_Clicked" />

                </VerticalStackLayout>
            </Border>

            <!-- İŞLETME -->
            <Border
                BackgroundColor="White"
                Stroke="#DFE5EF"
                StrokeShape="RoundRectangle 18"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="İşletme Girişi"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#142D5C" />

                    <Label
                        Text="Randevularını, personelini ve hizmetlerini yönet."
                        FontSize="14"
                        TextColor="#64748B" />

                    <Button
                        Text="İşletme Paneline Giriş →"
                        BackgroundColor="#EFF4FF"
                        TextColor="#1D4ED8"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="Isletme_Clicked" />

                </VerticalStackLayout>
            </Border>

            <!-- PLATFORM -->
            <Border
                BackgroundColor="White"
                Stroke="#DFE5EF"
                StrokeShape="RoundRectangle 18"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Platform Girişi"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#142D5C" />

                    <Label
                        Text="ATLAS platform yönetim alanı."
                        FontSize="14"
                        TextColor="#64748B" />

                    <Button
                        Text="Platform Yönetimine Giriş →"
                        BackgroundColor="#EFF4FF"
                        TextColor="#1D4ED8"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="Platform_Clicked" />

                </VerticalStackLayout>
            </Border>

            <Label
                Text="ATLAS SOFT © 2026"
                FontSize="12"
                TextColor="#94A3B8"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
