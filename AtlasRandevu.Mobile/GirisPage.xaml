<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AtlasRandevu.Mobile.GirisPage"
    BackgroundColor="#081426"
    Title="İşletme Girişi">

    <ScrollView>
        <VerticalStackLayout
            Padding="26,55,26,30"
            Spacing="18">

            <!-- LOGO -->
            <Image
                Source="atlas_login.png"
                HeightRequest="125"
                WidthRequest="125"
                Aspect="AspectFit"
                HorizontalOptions="Center"/>

            <Label
                Text="ATLAS RANDEVU"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="İŞLETME YÖNETİMİ"
                FontSize="13"
                CharacterSpacing="3"
                TextColor="#60A5FA"
                HorizontalTextAlignment="Center"/>

            <!-- GİRİŞ KARTI -->
            <Border
                BackgroundColor="#12223B"
                Stroke="#263B59"
                StrokeShape="RoundRectangle 24"
                Padding="22"
                Margin="0,25,0,0">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Hoş Geldiniz"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"/>

                    <Label
                        Text="İşletme hesabınızla giriş yapın"
                        FontSize="13"
                        TextColor="#94A3B8"/>

                    <!-- E-POSTA -->
                    <Label
                        Text="E-posta Adresi"
                        TextColor="#CBD5E1"
                        FontAttributes="Bold"
                        Margin="0,10,0,0"/>

                    <Border
                        BackgroundColor="#1C304D"
                        Stroke="#334B6C"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,2">

                        <Entry
                            x:Name="EmailEntry"
                            Placeholder="E-posta adresiniz"
                            PlaceholderColor="#7185A2"
                            Keyboard="Email"
                            TextColor="White"
                            BackgroundColor="Transparent"/>

                    </Border>

                    <!-- ŞİFRE -->
                    <Label
                        Text="Şifre"
                        TextColor="#CBD5E1"
                        FontAttributes="Bold"/>

                    <Border
                        BackgroundColor="#1C304D"
                        Stroke="#334B6C"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,2">

                        <Entry
                            x:Name="PasswordEntry"
                            Placeholder="Şifreniz"
                            PlaceholderColor="#7185A2"
                            IsPassword="True"
                            TextColor="White"
                            BackgroundColor="Transparent"/>

                    </Border>

                    <!-- GİRİŞ BUTONU -->
                    <Button
                        Text="İŞLETME GİRİŞİ"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="54"
                        Margin="0,15,0,0"
                        Clicked="GirisYap_Clicked"/>

                    <Label
                        Text="Mevcut ATLAS Randevu hesabınızla giriş yapabilirsiniz."
                        FontSize="12"
                        TextColor="#94A3B8"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>
            </Border>

            <Label
                Text="ATLAS SOFT © 2026"
                FontSize="12"
                TextColor="#64748B"
                HorizontalTextAlignment="Center"
                Margin="0,25,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
